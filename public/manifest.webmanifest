{
    "name": "Alima",
    "short_name": "Alima",
    "description": "Plan, create and schedule your brand's social media.",
    "id": "/today",
    "start_url": "/today?source=pwa",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait-primary",
    "background_color": "#F5F2E8",
    "theme_color": "#205557",
    "icons": [
        {
            "src": "/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Quick post",
            "short_name": "Quick post",
            "description": "Snap a photo and get it scheduled.",
            "url": "/posts/quick?source=pwa",
            "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
        },
        {
            "name": "Today",
            "short_name": "Today",
            "description": "What's going out and what needs you.",
            "url": "/today?source=pwa"
        }
    ],
    "share_target": {
        "action": "/posts/quick/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [{ "name": "media", "accept": ["image/*", "video/*"] }]
        }
    }
}
