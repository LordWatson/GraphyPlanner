<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            One boot of this app peaks at ~36MB, but PHPUnit holds every test's application for the
            life of the process, so the suite grows past PHP's 128MB default somewhere in the
            2,300th test and dies. The failure surfaces as an exhaustion inside
            `bootstrap/cache/routes-v7.php` — the largest single allocation in a boot, and so where
            the limit happens to land — which reads like a routing problem and is not one. Setting
            it here means `composer test` works on a default PHP install.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PUBLISH_HTTP_RETRY_BASE_MS" value="0"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- The suite must never be able to reach a real Stripe account, whatever is in `.env`. -->
        <env name="STRIPE_KEY" value=""/>
        <env name="STRIPE_SECRET" value=""/>
        <env name="AI_ENABLED" value="false"/>
        <env name="ANTHROPIC_API_KEY" value=""/>
        <env name="AI_IMAGE_PROVIDER" value="null"/>
        <env name="GEMINI_API_KEY" value=""/>
        <env name="OPENAI_API_KEY" value=""/>
        <env name="AI_IMAGE_TEXT_PROVIDER" value=""/>
    </php>
</phpunit>
