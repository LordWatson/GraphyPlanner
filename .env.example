APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_STACK=json (one JSON object per line, with the correlation id under `extra`).
# LOG_JSON_PATH=php://stderr

# Step M-1.1: error tracking (Sentry) and on-call alerts. No DSN = nothing is sent.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.1
OPS_ALERT_MAIL_TO=
# OPS_ALERT_LOG_CHANNEL=slack
OPS_ALERT_THROTTLE_MINUTES=10

# Laravel Pulse (/pulse, super admins only). Use the redis ingest + `php artisan pulse:work` in production.
PULSE_ENABLED=true
PULSE_INGEST_DRIVER=storage

# Graphy runs on MySQL 8 (the test suite uses in-memory SQLite via phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=graphy_planner
DB_USERNAME=root
DB_PASSWORD=

# Step I-2.8: sessions, cache, rate limits and queues run on Redis (Horizon runs the
# workers: `php artisan horizon`). Without Redis locally, set these to `database` instead.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Step M-1.2: defaults to true when APP_ENV=production.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must exceed the longest publish job's runtime so a slow publish isn't retried mid-flight.
REDIS_QUEUE_RETRY_AFTER=660
# Used instead when QUEUE_CONNECTION=database.
DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=redis
CACHE_LIMITER=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS=

# Transactional email (Resend). Set MAIL_MAILER=resend in production; empty key = nothing sends.
RESEND_API_KEY=

# Publishing vendor (Upload-Post) — the scheduler/adapter and its signed webhooks.
UPLOAD_POST_PLATFORM_KEY=
UPLOAD_POST_PLATFORM_WEBHOOK_SECRET=

# WhatsApp notifications (Twilio). Empty = nothing sends, and every WhatsApp path is a no-op.
# An organization can hold its own SID/token/sender instead (settings/organization); these are the
# platform fallback. `WHATSAPP_CLIENT=null` switches WhatsApp off entirely.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Must be a public https URL; leave empty in local development.
TWILIO_STATUS_CALLBACK_URL=
# One approved Content template SID (HX…) per message. `php artisan whatsapp:templates` prints
# what to submit and which var each one belongs in; a template with no SID simply never sends.
TWILIO_TEMPLATE_VERIFY_CODE=
TWILIO_TEMPLATE_POST_WAITING_CLIENT=
TWILIO_TEMPLATE_POST_SCHEDULED_REMINDER=
TWILIO_TEMPLATE_POST_DECIDED=
TWILIO_TEMPLATE_POST_PUBLISH_FAILED=
TWILIO_TEMPLATE_APPROVAL_OVERDUE=
TWILIO_TEMPLATE_INVOICE_ISSUED=
TWILIO_TEMPLATE_CAMPAIGN_BRIEF_READY=
TWILIO_TEMPLATE_DAILY_DIGEST=
TWILIO_TEMPLATE_NOTIFICATION=

# Meta (Facebook/Instagram) OAuth + Graph API for connecting those accounts directly.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
FACEBOOK_GRAPH_BASE_URL=https://graph.facebook.com
FACEBOOK_GRAPH_VERSION=v20.0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI (Anthropic Messages API) - Step 2.2/2.7
AI_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL_REASONING=claude-sonnet-5-5
AI_MODEL_CHEAP=claude-haiku-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
# low|medium|high|xhigh|max - how much the model thinks before answering
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT=90
ANTHROPIC_MAX_TOKENS=4096

# AI Image Studio - Phase 16 (provider: gemini|openai|null). Image jobs run on their own queue:
# php artisan queue:work --queue=ai-images
AI_IMAGE_PROVIDER=null
GEMINI_API_KEY=
GEMINI_IMAGE_DRAFT_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FINAL_MODEL=gemini-3-pro-image
AI_IMAGE_BRIEF_MODEL=
AI_IMAGE_TIMEOUT=90
AI_IMAGE_MAX_VARIANTS=4
AI_IMAGE_MAX_REFERENCES=8
AI_IMAGE_QUEUE=ai-images
AI_IMAGE_SETS_PER_MINUTE=10
AI_IMAGE_PRUNE_AFTER_DAYS=30
# Optional second adapter for headline/text-heavy designs (Step 16.12)
AI_IMAGE_TEXT_PROVIDER=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Design & cloud imports - Step M-5.9. One OAuth app per provider (Graphy's, not each agency's);
# each agency then connects its own account. A provider is only offered when both id + secret are
# set. Redirect URIs to register: {APP_URL}/design-imports/{canva|google_drive|dropbox}/callback.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Stripe — subscriptions via Laravel Cashier (Phase CG-2). The Organization is the billable.
# STRIPE_KEY is the publishable key (pk_*), STRIPE_SECRET the secret key (sk_*) — those two names
# are the ones Cashier reads (`config/cashier.php`), so a key parked under any other name is simply
# never used: checkout then dies inside the Stripe SDK with "api_key cannot be the empty string".
# STRIPE_WEBHOOK_SECRET verifies POST /stripe/webhook.
# Billing ships dark behind the super-admin switch (Super admin → Settings) + the per-org override,
# so these can stay blank until real Stripe products/prices exist.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=gbp

# Plan Stripe Price IDs (Step CG-2.1). Leave blank until the prices are created in Stripe; a plan
# with no price id simply can't be checked out yet (the plan page explains this). GBP + USD,
# monthly + annual (annual = two months free).
STRIPE_PRICE_BUSINESS_PRO_GBP_MONTHLY=
STRIPE_PRICE_BUSINESS_PRO_GBP_ANNUAL=
STRIPE_PRICE_BUSINESS_PRO_USD_MONTHLY=
STRIPE_PRICE_BUSINESS_PRO_USD_ANNUAL=
STRIPE_PRICE_CREATOR_PRO_GBP_MONTHLY=
STRIPE_PRICE_CREATOR_PRO_GBP_ANNUAL=
STRIPE_PRICE_CREATOR_PRO_USD_MONTHLY=
STRIPE_PRICE_CREATOR_PRO_USD_ANNUAL=
STRIPE_PRICE_AGENCY_STARTER_GBP_MONTHLY=
STRIPE_PRICE_AGENCY_STARTER_GBP_ANNUAL=
STRIPE_PRICE_AGENCY_STARTER_USD_MONTHLY=
STRIPE_PRICE_AGENCY_STARTER_USD_ANNUAL=
STRIPE_PRICE_AGENCY_STANDARD_GBP_MONTHLY=
STRIPE_PRICE_AGENCY_STANDARD_GBP_ANNUAL=
STRIPE_PRICE_AGENCY_STANDARD_USD_MONTHLY=
STRIPE_PRICE_AGENCY_STANDARD_USD_ANNUAL=
STRIPE_PRICE_AGENCY_SCALE_GBP_MONTHLY=
STRIPE_PRICE_AGENCY_SCALE_GBP_ANNUAL=
STRIPE_PRICE_AGENCY_SCALE_USD_MONTHLY=
STRIPE_PRICE_AGENCY_SCALE_USD_ANNUAL=
