APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_STACK=json (one JSON object per line, with the correlation id under `extra`).
# LOG_JSON_PATH=php://stderr

# Step M-1.1: error tracking (Sentry) and on-call alerts. No DSN = nothing is sent.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0.1
OPS_ALERT_MAIL_TO=
# OPS_ALERT_LOG_CHANNEL=slack
OPS_ALERT_THROTTLE_MINUTES=10

# Laravel Pulse (/pulse, super admins only). Use the redis ingest + `php artisan pulse:work` in production.
PULSE_ENABLED=true
PULSE_INGEST_DRIVER=storage

# Graphy runs on MySQL 8 (the test suite uses in-memory SQLite via phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=graphy_planner
DB_USERNAME=root
DB_PASSWORD=

# Step I-2.8: sessions, cache, rate limits and queues run on Redis (Horizon runs the
# workers: `php artisan horizon`). Without Redis locally, set these to `database` instead.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Step M-1.2: defaults to true when APP_ENV=production.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=660

CACHE_STORE=redis
CACHE_LIMITER=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI (DeepSeek) - Step 2.2/2.7
AI_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_TOKENS=1024

# AI Image Studio - Phase 16 (provider: gemini|openai|null). Image jobs run on their own queue:
# php artisan queue:work --queue=ai-images
AI_IMAGE_PROVIDER=null
GEMINI_API_KEY=
GEMINI_IMAGE_DRAFT_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FINAL_MODEL=gemini-3-pro-image
AI_IMAGE_BRIEF_MODEL=
AI_IMAGE_TIMEOUT=90
AI_IMAGE_MAX_VARIANTS=4
AI_IMAGE_MAX_REFERENCES=8
AI_IMAGE_QUEUE=ai-images
AI_IMAGE_SETS_PER_MINUTE=10
AI_IMAGE_PRUNE_AFTER_DAYS=30
# Optional second adapter for headline/text-heavy designs (Step 16.12)
AI_IMAGE_TEXT_PROVIDER=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

VITE_APP_NAME="${APP_NAME}"
